ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8000

FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=sqlite:///./data/app.db

CRM_BASE_URL=http://localhost:8101
BILLING_BASE_URL=http://localhost:8102

MCP_HOST=127.0.0.1
MCP_PORT=8200
MCP_SERVER_URL=http://127.0.0.1:8200/mcp

INVESTIGATION_MAX_LLM_CALLS=8
INVESTIGATOR_MAX_TOOL_CALLS=8

# Leave unset for local Vite (`npm run dev`) so the UI uses the `/api` proxy.
# Set only when the browser should call the API host directly:
# VITE_API_URL=http://127.0.0.1:8000
VITE_API_URL=

GOOGLE_API_KEY=

ADK_APP_NAME=resolveops-ai
ADK_MODEL=gemini-3.6-flash

MODEL_TEMPERATURE=0.1
MODEL_TIMEOUT_MS=30000
MODEL_RETRY_ATTEMPTS=3

MAX_LLM_CALLS_PER_RUN=5

PLANNER_MAX_LLM_CALLS=2
REVIEWER_MAX_LLM_CALLS=2
MAX_PLAN_REVISIONS=1

EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

GOOGLE_OAUTH_CLIENT_ID=
OPERATOR_EMAILS=operator@example.com

POLICY_DOCUMENTS_DIR=documents/policies
POLICY_INDEX_PATH=data/policy_index.json
POLICY_SEARCH_TOP_K=3

OTEL_ENABLED=true
OTEL_SERVICE_NAME=resolveops-backend

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

OTEL_CONSOLE_EXPORTER=false

MODEL_INPUT_COST_PER_MILLION=1.50
MODEL_OUTPUT_COST_PER_MILLION=7.50

ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
